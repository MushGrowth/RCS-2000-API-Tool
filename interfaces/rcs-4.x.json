    {
      "display_name": "交管区申请与释放",
      "suffix": "wcs/api/outer/rest/trafficTask",
      "method": "POST",
      "base_url": "root",
      "fields": [
        {
          "name": "eqptCode",
          "requirement": "必填"
        },
        {
          "name": "method",
          "requirement": "必填-APPLY_RESOURCE申请/RELEASE_RESOURCE释放"
        },
        {
          "name": "taskCode",
          "requirement": "必填-申请和释放保持一致"
        },
        {
          "name": "srcCode",
          "requirement": "条件必填-申请时必填"
        },
        {
          "name": "syncMode",
          "requirement": "条件必填-申请时必填,0异步/1同步"
        },
        {
          "name": "robotCode",
          "requirement": "选填"
        }
      ],
      "rules": [
        {
          "type": "required_if",
          "field": "srcCode",
          "when": {
            "field": "method",
            "equals": "APPLY_RESOURCE"
          }
        },
        {
          "type": "required_if",
          "field": "syncMode",
          "when": {
            "field": "method",
            "equals": "APPLY_RESOURCE"
          }
        }
      ]
    }
